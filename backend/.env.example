OPENAI_API_KEY=sk-...
PORT=8787

# Transcription provider (default groq). Get a key at https://console.groq.com/keys
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
# openai fallback: TRANSCRIBE_PROVIDER=openai + OPENAI_API_KEY=...
# local fallback:  TRANSCRIBE_PROVIDER=local + WHISPER_BASE_URL=http://127.0.0.1:8080/v1

# Conversational "brain" model (Groq chat). Decides answer-vs-relay-to-Claude.
# Reuses GROQ_API_KEY / GROQ_BASE_URL above.
GROQ_BRAIN_MODEL=llama-3.3-70b-versatile

# Voz (TTS). browser = speechSynthesis del navegador (gratis, robótico).
TTS_PROVIDER=browser            # browser | elevenlabs | openai
# ElevenLabs (la más natural): https://elevenlabs.io  → API key + elegí una voz
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # cambialo por tu voz preferida (dashboard de ElevenLabs)
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OpenAI (más barata): TTS_PROVIDER=openai + OPENAI_API_KEY=... + OPENAI_TTS_VOICE=nova
