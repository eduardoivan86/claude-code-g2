OPENAI_API_KEY=sk-...
PORT=8787

# Transcription provider (default groq). Get a key at https://console.groq.com/keys
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
# openai fallback: TRANSCRIBE_PROVIDER=openai + OPENAI_API_KEY=...
# local fallback:  TRANSCRIBE_PROVIDER=local + WHISPER_BASE_URL=http://127.0.0.1:8080/v1

# Conversational "brain" model (Groq chat). Decides answer-vs-relay-to-Claude.
# Reuses GROQ_API_KEY / GROQ_BASE_URL above.
GROQ_BRAIN_MODEL=llama-3.3-70b-versatile
